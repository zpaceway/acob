{
  "manifest_version": 3,
  "name": "ACOB",
  "version": "0.1.0",
  "minimum_chrome_version": "116",
  "description": "Runs browser instructions received from the ACOB server.",
  "permissions": ["debugger", "offscreen", "storage", "tabs"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}
