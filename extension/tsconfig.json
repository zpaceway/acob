{
  "compilerOptions": {
    "exactOptionalPropertyTypes": true,
    "lib": ["ES2023", "DOM", "WebWorker"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2023",
    "types": ["chrome", "node"]
  },
  "include": ["build.ts", "src/**/*.ts", "tests/**/*.ts"]
}
