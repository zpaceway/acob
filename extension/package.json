{
  "name": "@zpaceway/acob-extension",
  "version": "0.14.0",
  "description": "Chromium extension for executing ACOB browser instructions.",
  "keywords": [
    "browser-automation",
    "chrome-extension",
    "chromium",
    "typescript"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zpaceway/acob.git",
    "directory": "extension"
  },
  "bugs": {
    "url": "https://github.com/zpaceway/acob/issues"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsx build.ts",
    "prepack": "npm run build",
    "test": "tsx --test \"tests/**/*.test.ts\"",
    "test:coverage": "tsx --test --experimental-test-coverage --test-coverage-include=\"src/**/*.ts\" --test-coverage-exclude=\"tests/**\" --test-coverage-lines=90 --test-coverage-functions=90 \"tests/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "@types/chrome": "0.2.2",
    "@types/node": "26.1.2",
    "devtools-protocol": "0.0.1669207",
    "happy-dom": "^20.14.3",
    "jquery": "4.0.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.1",
    "turndown": "7.2.4",
    "typescript": "7.0.2"
  }
}
